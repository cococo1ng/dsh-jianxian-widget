{
  "name": "dsh-jianxian-widget",
  "version": "4.27.2",
  "description": "右下角的青云剑仙：白发墨金的剑修，会御剑、会守炉，也会催你早点睡。23 个常驻 + 24 帧剑舞、14 件法宝皮肤、10 路音效；黑衣白衣随主题换。盯余额、记消耗、按轮报账，气泡逐行可改。全本地运行，素材内联、不占 token。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "screenshot.png",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "widget",
    "desktop-pet",
    "jianxian",
    "xianxia"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node test-teeth.mjs",
    "test:guard": "node test-routes.mjs && node test-billing.mjs",
    "test:audit": "node audit-teeth.mjs && node audit-teeth.mjs --selftest",
    "test:copy": "node check-copy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cococo1ng/dsh-jianxian-widget.git"
  },
  "homepage": "https://github.com/cococo1ng/dsh-jianxian-widget#readme",
  "bugs": {
    "url": "https://github.com/cococo1ng/dsh-jianxian-widget/issues"
  }
}
